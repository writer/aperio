# Copy this file to .env.production and replace every value marked replace-me.
POSTGRES_USER=aperio
POSTGRES_PASSWORD=replace-me-with-a-long-random-password
POSTGRES_DB=aperio

# The browser origin and the API origin must be reachable by operators.
APERIO_WEB_ORIGIN=https://aperio.example.com
NEXT_PUBLIC_CONNECT_API_BASE_URL=https://aperio-api.example.com
APERIO_CONNECT_PORT=4100
APERIO_WEB_PORT=3000

# Generate with:
# node -e "console.log('base64:' + require('node:crypto').randomBytes(32).toString('base64'))"
APERIO_ENCRYPTION_KEY=base64:replace-me-with-a-32-byte-key
APERIO_AUTH_SECRET=replace-me-with-at-least-32-random-characters

# The release image is signed and published to GHCR. Prefer the immutable
# digest from the release-receipt artifact after the first pull/verification.
APERIO_IMAGE_REF=ghcr.io/writer/aperio:v0.1.0
APERIO_EVENT_BUS=nats
APERIO_NATS_STREAM=CEREBRO_EVENTS
